# AI Banking Firewall Environment Configuration
# Copy this file to .env and fill in your values

# ── Required ────────────────────────────────────────────────────────────────
# Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# ── Layer 2 thresholds ───────────────────────────────────────────────────────
# Heuristic score at/above which Layer 3 (LLM) is skipped entirely
HEURISTIC_BLOCK_THRESHOLD=0.75

# ── Layer 4 thresholds ───────────────────────────────────────────────────────
# Combined score at/above which the request is BLOCKED
BLOCK_THRESHOLD=0.60
# Combined score at/above which the request is CHALLENGE (step-up auth)
CHALLENGE_THRESHOLD=0.40
